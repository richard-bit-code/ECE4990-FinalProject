  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 4. Dataset Loader\n",
    "\n",
    "All three datasets use folder-based labels: `empty/` and `occupied/` (or `free/` and `busy/`). This generic loader handles all of them."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def find_class_folders(root):\n",
    "    \"\"\"Search recursively for occupied/empty folder pairs.\"\"\"\n",
    "    root = Path(root)\n",
    "    # Common label names across datasets\n",
    "    occupied_names = {'occupied', 'busy', '1', 'car'}\n",
    "    empty_names = {'empty', 'free', '0', 'no_car'}\n",
    "    \n",
    "    occupied_dirs, empty_dirs = [], []\n",
    "    for d in root.rglob('*'):\n",
    "        if d.is_dir():\n",
    "            name = d.name.lower()\n",
    "            if name in occupied_names:\n",
    "                occupied_dirs.append(d)\n",
    "            elif name in empty_names:\n",
    "                empty_dirs.append(d)\n",
    "    return occupied_dirs, empty_dirs\n",
    "\n",
    "\n",
    "def build_dataframe(root, dataset_name, max_per_class=2000):\n",
    "    \"\"\"Build a dataframe of image paths and labels from a dataset root.\"\"\"\n",
    "    occupied_dirs, empty_dirs = find_class_folders(root)\n",
    "    rows = []\n",
    "    exts = {'.jpg', '.jpeg', '.png', '.bmp'}\n",
    "\n",
    "    for d in occupied_dirs:\n",
    "        imgs = [p for p in d.iterdir() if p.suffix.lower() in exts]\n",
    "        for p in imgs:\n",
    "            rows.append({'path': str(p), 'label': 1, 'dataset': dataset_name})\n",
    "\n",
    "    for d in empty_dirs:\n",
    "        imgs = [p for p in d.iterdir() if p.suffix.lower() in exts]\n",
    "        for p in imgs:\n",
    "            rows.append({'path': str(p), 'label': 0, 'dataset': dataset_name})\n",
    "\n",
    "    df = pd.DataFrame(rows)\n",
    "    # Balance classes and cap size\n",
    "    occ = df[df.label==1].sample(min(max_per_class, (df.label==1).sum()), random_state=SEED)\n",
    "    emp = df[df.label==0].sample(min(max_per_class, (df.label==0).sum()), random_state=SEED)\n",
    "    df = pd.concat([occ, emp]).sample(frac=1, random_state=SEED).reset_index(drop=True)\n",
    "    print(f'{dataset_name}: {len(df)} images | occupied={len(occ)} | empty={len(emp)}')\n",
    "    return df\n",
    "\n",
    "\n",
    "# Build dataframes for each dataset\n",
    "df_pklot   = build_dataframe('data/pklot',        'PKLot')\n",
    "df_cnrpark = build_dataframe('data/cnrpark',       'CNRPark-EXT')\n",
    "df_slot    = build_dataframe('data/parking_slot',  'ParkingSlot')\n",
    "\n",
    "# Combined dataset for training\n",
    "df_all = pd.concat([df_pklot, df_cnrpark, df_slot]).sample(frac=1, random_state=SEED).reset_index(drop=True)\n",
    "print(f'\\nTotal combined: {len(df_all)} images')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Train/Val/Test split (70/15/15)\n",
    "from sklearn.model_selection import train_test_split\n",
    "\n",
    "def split_df(df, test_size=0.15, val_size=0.15):\n",
    "    train, test = train_test_split(df, test_size=test_size, random_state=SEED, stratify=df['label'])\n",
    "    train, val  = train_test_split(train, test_size=val_size/(1-test_size), random_state=SEED, stratify=train['label'])\n",
    "    return train.reset_index(drop=True), val.reset_index(drop=True), test.reset_index(drop=True)\n",
    "\n",
    "train_df, val_df, test_df = split_df(df_all)\n",
    "print(f'Train: {len(train_df)} | Val: {len(val_df)} | Test: {len(test_df)}')\n",
    "\n",
    "# Per-dataset test splits for cross-dataset evaluation\n",
    "_, _, test_pklot   = split_df(df_pklot)\n",
    "_, _, test_cnrpark = split_df(df_cnrpark)\n",
    "_, _, test_slot    = split_df(df_slot)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# PyTorch Dataset\n",
    "IMG_SIZE = 224\n",
    "\n",
    "train_transform = transforms.Compose([\n",
    "    transforms.Resize((IMG_SIZE, IMG_SIZE)),\n",
    "    transforms.RandomHorizontalFlip(),\n",
    "    transforms.RandomRotation(15),\n",
    "    transforms.ColorJitter(brightness=0.3, contrast=0.3, saturation=0.2),\n",
    "    transforms.ToTensor(),\n",
    "    transforms.Normalize([0.485, 0.456, 0.406], [0.229, 0.224, 0.225])\n",
    "])\n",
    "\n",
    "val_transform = transforms.Compose([\n",
    "    transforms.Resize((IMG_SIZE, IMG_SIZE)),\n",
    "    transforms.ToTensor(),\n",
    "    transforms.Normalize([0.485, 0.456, 0.406], [0.229, 0.224, 0.225])\n",
    "])\n",
    "\n",
    "class ParkingDataset(Dataset):\n",
    "    def __init__(self, df, transform=None):\n",
    "        self.df = df\n",
    "        self.transform = transform\n",
    "\n",
    "    def __len__(self):\n",
    "        return len(self.df)\n",
    "\n",
    "    def __getitem__(self, idx):\n",
    "        row = self.df.iloc[idx]\n",
    "        try:\n",
    "            img = Image.open(row['path']).convert('RGB')\n",
    "        except:\n",
    "            img = Image.fromarray(np.zeros((IMG_SIZE, IMG_SIZE, 3), dtype=np.uint8))\n",
    "        if self.transform:\n",
    "            img = self.transform(img)\n",
    "        return img, int(row['label'])\n",
    "\n",
    "BATCH = 32\n",
    "train_loader = DataLoader(ParkingDataset(train_df, train_transform), batch_size=BATCH, shuffle=True,  num_workers=2, pin_memory=True)\n",
    "val_loader   = DataLoader(ParkingDataset(val_df,   val_transform),   batch_size=BATCH, shuffle=False, num_workers=2, pin_memory=True)\n",
    "test_loader  = DataLoader(ParkingDataset(test_df,  val_transform),   batch_size=BATCH, shuffle=False, num_workers=2, pin_memory=True)\n",
    "\n",
    "# Per-dataset test loaders\n",
    "loader_pklot   = DataLoader(ParkingDataset(test_pklot,   val_transform), batch_size=BATCH, shuffle=False, num_workers=2)\n",
    "loader_cnrpark = DataLoader(ParkingDataset(test_cnrpark, val_transform), batch_size=BATCH, shuffle=False, num_workers=2)\n",
    "loader_slot    = DataLoader(ParkingDataset(test_slot,    val_transform), batch_size=BATCH, shuffle=False, num_workers=2)\n",
    "\n",
    "print('DataLoaders ready!')"
   ]
  },
  {
   "cell_type": "markdown",
