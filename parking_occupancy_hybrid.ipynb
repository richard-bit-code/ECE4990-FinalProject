   "source": [
    "# Train Baseline\n",
    "print('=' * 60)\n",
    "print('TRAINING BASELINE: EfficientNet-B0')\n",
    "print('=' * 60)\n",
    "baseline_model, baseline_history = train_model(\n",
    "    EfficientNetBaseline(), train_loader, val_loader,\n",
    "    epochs=10, lr=1e-4, model_name='efficientnet_baseline'\n",
    ")"
