    "def show_predictions(model, dataset_df, n=8, model_name='Model'):\n",
    "    model.eval()\n",
    "    sample = dataset_df.sample(n, random_state=SEED)\n",
    "    fig, axes = plt.subplots(2, n//2, figsize=(16, 6))\n",
    "    axes = axes.flatten()\n",
    "    class_labels = {0: 'Empty', 1: 'Occupied'}\n",
    "\n",
    "    for i, (_, row) in enumerate(sample.iterrows()):\n",
    "        try:\n",
    "            img = Image.open(row['path']).convert('RGB')\n",
    "        except:\n",
    "            continue\n",
    "        tensor = val_transform(img).unsqueeze(0).to(DEVICE)\n",
    "        with torch.no_grad():\n",
    "            pred = model(tensor).argmax(1).item()\n",
    "        true = int(row['label'])\n",
    "        color = 'green' if pred == true else 'red'\n",
    "        axes[i].imshow(img)\n",
    "        axes[i].set_title(f'True: {class_labels[true]}\\nPred: {class_labels[pred]}',\n",
    "                          color=color, fontsize=9)\n",
    "        axes[i].axis('off')\n",
    "\n",
    "    plt.suptitle(f'{model_name} — Sample Predictions (Green=Correct, Red=Wrong)',\n",
    "                 fontsize=12, fontweight='bold')\n",
    "    plt.tight_layout()\n",
    "    fname = f'predictions_{model_name.lower().replace(\" \", \"_\")}.png'\n",
    "    plt.savefig(fname, dpi=150, bbox_inches='tight')\n",
    "    plt.show()\n",
    "    print(f'Saved {fname}')\n",
    "\n",
    "show_predictions(baseline_model, test_df, n=8, model_name='EfficientNet-B0 Baseline')\n",
    "show_predictions(proposed_model,  test_df, n=8, model_name='EfficientNet MobileViT Proposed')"
