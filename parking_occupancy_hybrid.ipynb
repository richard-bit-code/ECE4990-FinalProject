   "source": [
    "## 5. Model Architectures\n",
    "\n",
    "### 5A. Baseline — EfficientNet-B0"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "class EfficientNetBaseline(nn.Module):\n",
    "    \"\"\"Standard EfficientNet-B0 fine-tuned for binary parking classification.\"\"\"\n",
    "    def __init__(self, num_classes=2, pretrained=True):\n",
    "        super().__init__()\n",
    "        self.backbone = timm.create_model('efficientnet_b0', pretrained=pretrained, num_classes=0)\n",
    "        feat_dim = self.backbone.num_features  # 1280\n",
    "        self.classifier = nn.Sequential(\n",
    "            nn.Dropout(0.3),\n",
    "            nn.Linear(feat_dim, num_classes)\n",
    "        )\n",
    "\n",
    "    def forward(self, x):\n",
    "        features = self.backbone(x)   # (B, 1280)\n",
    "        return self.classifier(features)\n",
    "\n",
    "print('Baseline model defined.')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### 5B. Proposed — EfficientNet-B0 + MobileViT Block (Novelty)\n",
    "\n",
    "The key idea: after EfficientNet extracts local CNN features, a **MobileViT block** applies lightweight self-attention to capture global spatial context across the parking slot — helping detect occlusion and lighting variation that confuses pure CNN approaches."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "class MobileViTBlock(nn.Module):\n",
    "    \"\"\"\n",
    "    Lightweight MobileViT block that fuses local CNN features with global\n",
    "    self-attention. Applied to the feature map from EfficientNet before\n",
    "    global average pooling.\n",
    "\n",
    "    Architecture:\n",
    "      Local conv -> Unfold patches -> Transformer -> Fold back -> Proj conv\n",
    "    \"\"\"\n",
    "    def __init__(self, dim, depth=2, num_heads=4, patch_size=2, mlp_ratio=2.0, dropout=0.1):\n",
    "        super().__init__()\n",
    "        self.patch_size = patch_size\n",
    "        patch_dim = dim * patch_size * patch_size\n",
    "\n",
    "        # Local representation\n",
    "        self.local_conv = nn.Sequential(\n",
    "            nn.Conv2d(dim, dim, kernel_size=3, padding=1, groups=dim, bias=False),\n",
    "            nn.BatchNorm2d(dim),\n",
    "            nn.SiLU(),\n",
    "            nn.Conv2d(dim, dim, kernel_size=1, bias=False),\n",
    "        )\n",
    "\n",
    "        # Global representation via Transformer\n",
    "        self.norm = nn.LayerNorm(patch_dim)\n",
    "        encoder_layer = nn.TransformerEncoderLayer(\n",
    "            d_model=patch_dim,\n",
    "            nhead=num_heads,\n",
    "            dim_feedforward=int(patch_dim * mlp_ratio),\n",
    "            dropout=dropout,\n",
    "            activation='gelu',\n",
    "            batch_first=True,\n",
    "            norm_first=True\n",
    "        )\n",
    "        self.transformer = nn.TransformerEncoder(encoder_layer, num_layers=depth)\n",
    "\n",
    "        # Projection back\n",
    "        self.proj = nn.Sequential(\n",
    "            nn.Conv2d(dim, dim, kernel_size=1, bias=False),\n",
    "            nn.BatchNorm2d(dim),\n",
    "        )\n",
    "\n",
    "    def forward(self, x):\n",
    "        # x: (B, C, H, W)\n",
    "        B, C, H, W = x.shape\n",
    "        P = self.patch_size\n",
    "\n",
    "        # Pad if needed\n",
    "        pad_h = (P - H % P) % P\n",
    "        pad_w = (P - W % P) % P\n",
    "        if pad_h or pad_w:\n",
    "            x = nn.functional.pad(x, (0, pad_w, 0, pad_h))\n",
    "        _, _, H2, W2 = x.shape\n",
    "\n",
    "        # Local conv\n",
    "        local_out = self.local_conv(x)  # (B, C, H2, W2)\n",
    "\n",
    "        # Unfold into patches: (B, C*P*P, num_patches)\n",
    "        patches = x.unfold(2, P, P).unfold(3, P, P)  # (B, C, H2/P, W2/P, P, P)\n",
    "        ph, pw = H2 // P, W2 // P\n",
    "        patches = patches.contiguous().view(B, C, ph, pw, P * P)\n",
    "        patches = patches.permute(0, 2, 3, 1, 4).contiguous()  # (B, ph, pw, C, P*P)\n",
    "        patches = patches.view(B, ph * pw, C * P * P)           # (B, N, C*P*P)\n",
    "\n",
    "        # Transformer\n",
    "        patches = self.norm(patches)\n",
    "        patches = self.transformer(patches)                      # (B, N, C*P*P)\n",
    "\n",
    "        # Fold back to spatial\n",
    "        patches = patches.view(B, ph, pw, C, P, P)\n",
    "        patches = patches.permute(0, 3, 1, 4, 2, 5).contiguous()  # (B, C, ph, P, pw, P)\n",
    "        global_out = patches.view(B, C, H2, W2)                    # (B, C, H2, W2)\n",
    "\n",
    "        # Fuse local + global\n",
    "        out = self.proj(local_out + global_out)\n",
    "\n",
    "        # Remove padding\n",
    "        if pad_h or pad_w:\n",
    "            out = out[:, :, :H, :W]\n",
    "\n",
    "        return out + x[:, :, :H, :W]  # residual\n",
    "\n",
    "\n",
    "class EfficientNetMobileViT(nn.Module):\n",
    "    \"\"\"\n",
    "    Proposed hybrid model:\n",
    "      EfficientNet-B0 feature extractor (remove head)\n",
    "      -> MobileViT block on final feature map\n",
    "      -> Global Average Pooling\n",
    "      -> Classifier\n",
    "    \"\"\"\n",
    "    def __init__(self, num_classes=2, pretrained=True):\n",
    "        super().__init__()\n",
    "        # EfficientNet-B0 without classifier and pooling\n",
    "        self.backbone = timm.create_model(\n",
    "            'efficientnet_b0',\n",
    "            pretrained=pretrained,\n",
    "            num_classes=0,\n",
    "            global_pool=''\n",
    "        )\n",
    "        # Feature map dim after last MBConv block = 320\n",
    "        feat_channels = 320\n",
    "\n",
    "        # MobileViT block — our novelty\n",
    "        self.mobile_vit = MobileViTBlock(\n",
    "            dim=feat_channels,\n",
    "            depth=2,\n",
    "            num_heads=4,\n",
    "            patch_size=2,\n",
    "            mlp_ratio=2.0,\n",
    "            dropout=0.1\n",
    "        )\n",
    "\n",
    "        # Conv projection to 1280 (match EfficientNet head dim)\n",
    "        self.proj = nn.Sequential(\n",
    "            nn.Conv2d(feat_channels, 1280, kernel_size=1, bias=False),\n",
    "            nn.BatchNorm2d(1280),\n",
    "            nn.SiLU()\n",
    "        )\n",
    "\n",
    "        self.pool = nn.AdaptiveAvgPool2d(1)\n",
    "\n",
    "        self.classifier = nn.Sequential(\n",
    "            nn.Dropout(0.3),\n",
    "            nn.Linear(1280, num_classes)\n",
    "        )\n",
    "\n",
    "    def forward(self, x):\n",
    "        # CNN feature map: (B, 320, 7, 7) for 224x224 input\n",
    "        feat = self.backbone(x)\n",
    "\n",
    "        # Ensure we have spatial dims\n",
    "        if feat.dim() == 2:\n",
    "            # fallback: some timm versions pool already\n",
    "            return self.classifier(feat)\n",
    "\n",
    "        # Apply MobileViT for local-global fusion\n",
    "        feat = self.mobile_vit(feat)   # (B, 320, 7, 7)\n",
    "        feat = self.proj(feat)          # (B, 1280, 7, 7)\n",
    "        feat = self.pool(feat)          # (B, 1280, 1, 1)\n",
    "        feat = feat.flatten(1)          # (B, 1280)\n",
    "        return self.classifier(feat)\n",
    "\n",
    "print('Proposed model defined.')\n",
    "\n",
    "# Quick sanity check\n",
    "with torch.no_grad():\n",
    "    dummy = torch.randn(2, 3, 224, 224)\n",
    "    baseline = EfficientNetBaseline()\n",
    "    proposed = EfficientNetMobileViT()\n",
    "    print(f'Baseline output shape: {baseline(dummy).shape}')\n",
    "    print(f'Proposed output shape: {proposed(dummy).shape}')\n",
    "    b_params = sum(p.numel() for p in baseline.parameters()) / 1e6\n",
    "    p_params = sum(p.numel() for p in proposed.parameters()) / 1e6\n",
    "    print(f'Baseline params: {b_params:.2f}M | Proposed params: {p_params:.2f}M')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 6. Training Loop"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def train_model(model, train_loader, val_loader, epochs=10, lr=1e-4, model_name='model'):\n",
    "    model = model.to(DEVICE)\n",
    "    criterion = nn.CrossEntropyLoss()\n",
    "    optimizer = optim.Adam(model.parameters(), lr=lr, weight_decay=1e-4)\n",
    "    scheduler = optim.lr_scheduler.CosineAnnealingLR(optimizer, T_max=epochs)\n",
    "\n",
    "    history = {'train_loss': [], 'val_loss': [], 'train_acc': [], 'val_acc': [], 'val_f1': []}\n",
    "    best_f1, best_state = 0.0, None\n",
    "\n",
    "    for epoch in range(epochs):\n",
    "        # --- Train ---\n",
    "        model.train()\n",
    "        t_loss, t_correct, t_total = 0.0, 0, 0\n",
    "        for imgs, labels in train_loader:\n",
    "            imgs, labels = imgs.to(DEVICE), labels.to(DEVICE)\n",
    "            optimizer.zero_grad()\n",
    "            out = model(imgs)\n",
    "            loss = criterion(out, labels)\n",
    "            loss.backward()\n",
    "            optimizer.step()\n",
    "            t_loss += loss.item() * imgs.size(0)\n",
    "            t_correct += (out.argmax(1) == labels).sum().item()\n",
    "            t_total += imgs.size(0)\n",
    "\n",
    "        # --- Validate ---\n",
    "        model.eval()\n",
    "        v_loss, all_preds, all_labels = 0.0, [], []\n",
    "        with torch.no_grad():\n",
    "            for imgs, labels in val_loader:\n",
    "                imgs, labels = imgs.to(DEVICE), labels.to(DEVICE)\n",
    "                out = model(imgs)\n",
    "                v_loss += criterion(out, labels).item() * imgs.size(0)\n",
    "                all_preds.extend(out.argmax(1).cpu().numpy())\n",
    "                all_labels.extend(labels.cpu().numpy())\n",
    "\n",
    "        t_acc = t_correct / t_total\n",
    "        v_acc = accuracy_score(all_labels, all_preds)\n",
    "        v_f1  = f1_score(all_labels, all_preds, average='macro')\n",
    "\n",
    "        history['train_loss'].append(t_loss / t_total)\n",
    "        history['val_loss'].append(v_loss / len(val_loader.dataset))\n",
    "        history['train_acc'].append(t_acc)\n",
    "        history['val_acc'].append(v_acc)\n",
    "        history['val_f1'].append(v_f1)\n",
    "\n",
    "        if v_f1 > best_f1:\n",
    "            best_f1 = v_f1\n",
    "            best_state = {k: v.cpu().clone() for k, v in model.state_dict().items()}\n",
    "\n",
    "        scheduler.step()\n",
    "        print(f'[{model_name}] Epoch {epoch+1:02d}/{epochs} | '\n",
    "              f'Train Loss: {t_loss/t_total:.4f} Acc: {t_acc:.4f} | '\n",
    "              f'Val Loss: {v_loss/len(val_loader.dataset):.4f} Acc: {v_acc:.4f} F1: {v_f1:.4f}')\n",
    "\n",
    "    # Restore best weights\n",
    "    model.load_state_dict(best_state)\n",
    "    torch.save(best_state, f'{model_name}_best.pth')\n",
    "    print(f'\\nBest Val F1: {best_f1:.4f} — saved to {model_name}_best.pth')\n",
    "    return model, history"
   ]
  },
